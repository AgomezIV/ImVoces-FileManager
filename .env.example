# ─── Base de datos (PostgreSQL remoto) ───────────────────────────────────────
# Servidor PostgreSQL del proyecto: 74.208.99.84
# Rellena usuario y contraseña reales en tu .env local (NUNCA se commitea).
DATABASE_URL="postgresql://imvoces:CAMBIAME@74.208.99.84:5432/imvoces?schema=public&sslmode=prefer"

# ─── Redis (cola de transferencias + pub/sub de progreso) ────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
# Orígenes permitidos por CORS, separados por coma. La app móvil no envía Origin.
CORS_ORIGINS="http://localhost:3000"

# ─── Sesiones ────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET="CAMBIAME_secreto_de_al_menos_32_caracteres_aleatorios"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ─── Cifrado de credenciales de proveedores (AES-256-GCM) ────────────────────
# openssl rand -base64 32   → debe decodificar a exactamente 32 bytes
CREDENTIALS_KEY="CAMBIAME_base64_de_32_bytes"

# ─── Google OAuth / Sign-In ──────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CAMBIAME"
# Client IDs adicionales aceptados al validar el idToken (Android / Web), separados por coma
GOOGLE_ALLOWED_AUDIENCES=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/accounts/callback"

# ─── Dropbox ─────────────────────────────────────────────────────────────────
# https://www.dropbox.com/developers/apps → Create app → Scoped access
# Redirect URI: el mismo GOOGLE_OAUTH_REDIRECT_URI de arriba.
# Si se deja vacío, la aplicación simplemente no ofrece Dropbox.
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""

# ─── Microsoft / OneDrive ────────────────────────────────────────────────────
# https://entra.microsoft.com → App registrations → cuentas personales y de trabajo
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ─── Espacio de almacenamiento incluido ──────────────────────────────────────
# UN bucket tuyo, con una carpeta por usuario (users/<userId>/). Así alguien que
# solo tiene Google Drive ya tiene un destino al que copiar, sin claves propias.
# Las claves son del operador y NUNCA se muestran a los usuarios.
MANAGED_STORAGE_ENABLED="false"
MANAGED_STORAGE_LABEL="Mi espacio ImVoces"
MANAGED_R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
MANAGED_R2_BUCKET=""
MANAGED_R2_REGION="auto"
# Cloudflare → R2 → Manage API tokens → Create token. De ahí salen estas dos.
# Un token de cuenta (cfat_...) NO sirve: la API S3 de R2 pide este par.
MANAGED_R2_ACCESS_KEY_ID=""
MANAGED_R2_SECRET_ACCESS_KEY=""

# ─── Motor de transferencias ─────────────────────────────────────────────────
TRANSFER_CONCURRENCY=4
TRANSFER_PART_SIZE_MB=16

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
